# Caddyfile - Production with automatic HTTPS
# Replace 'localhost' with your actual domain for automatic SSL

{
    # Global options
    email admin@legalia.com
}

# Development (localhost)
localhost {
    reverse_proxy legalia-frontend:5173

    handle /api/* {
        reverse_proxy legalia-api:8000
    }
}

