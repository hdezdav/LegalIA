# =============================================================================
# LegalIA Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL Configuration
# -----------------------------------------------------------------------------
POSTGRES_DB=legalia
POSTGRES_USER=legalia
POSTGRES_PASSWORD=change_this_password_in_production
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Database URL (constructed from above values)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=false

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost,http://localhost:80

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# LLM Provider Configuration
# -----------------------------------------------------------------------------
# Provider options: openai_compatible | anthropic | mock
# - openai_compatible: Works with OpenAI, LiteLLM, vLLM, Ollama, OpenRouter
# - anthropic: Direct Anthropic Claude API
# - mock: Offline testing without external LLM API
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=claude-sonnet-4.6

# Direct Anthropic Configuration (if using LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TEMPERATURE=0.0
ANTHROPIC_TIMEOUT_SECONDS=120.0
ANTHROPIC_MAX_RETRIES=2

# Grounding & Verification Model (runs on a lighter model)
VERIFIER_MODEL=claude-haiku-4.5

# Web Search Grounding (Optional: Tavily AI)
TAVILY_API_KEY=your_tavily_api_key_here

# -----------------------------------------------------------------------------
# Embeddings Configuration
# -----------------------------------------------------------------------------
# Provider: alibaba | bge | mock | pending
# - alibaba: real semantic embeddings via DashScope API (requires key)
# - bge: local BGE-M3 model (requires ~2.5GB dependencies)
# - mock: deterministic hash-based vectors for tests/offline dev
# - pending: acts like mock but signals intent for real embeddings (use this
#   while you're getting credentials or setting up infrastructure)
EMBEDDING_PROVIDER=pending

# Alibaba Configuration
ALIBABA_API_KEY=your_alibaba_api_key_here
ALIBABA_EMBEDDING_MODEL=text-embedding-v4
ALIBABA_EMBEDDING_DIMENSION=1024

# BGE-M3 Configuration (for future local deployment)
BGE_MODEL_PATH=/models/bge-m3
BGE_EMBEDDING_DIMENSION=1024
BGE_BATCH_SIZE=32

# -----------------------------------------------------------------------------
# Reranker Configuration
# -----------------------------------------------------------------------------
# Provider: alibaba | none | mock | pending
# - alibaba: real cross-encoder reranking via DashScope API (requires key)
# - none: no reranking, preserves retrieval order (scores 0.0, below threshold)
# - mock: lexical-only reranking for tests/offline dev
# - pending: acts like mock but signals intent for real reranking
RERANKER_PROVIDER=pending

# Alibaba Reranker
ALIBABA_RERANKER_API_KEY=your_alibaba_reranker_api_key_here
ALIBABA_RERANKER_MODEL=gte-rerank-hybrid

# -----------------------------------------------------------------------------
# Retrieval Configuration
# -----------------------------------------------------------------------------
# Number of candidates to retrieve before reranking
RETRIEVAL_TOP_K=20

# Number of chunks to use as context after reranking
RERANK_TOP_K=5

# Minimum similarity score for vector search
MIN_SIMILARITY_SCORE=0.5

# Hybrid search weights (semantic + lexical)
SEMANTIC_WEIGHT=0.7
LEXICAL_WEIGHT=0.3

# -----------------------------------------------------------------------------
# Caddy Configuration
# -----------------------------------------------------------------------------
DOMAIN=localhost
HTTPS_PORT=443
HTTP_PORT=80

# ACME Email for Let's Encrypt (optional, for production domains)
# ACME_EMAIL=admin@yourdomain.com

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_NAME=LegalIA
APP_VERSION=1.0.0
ENVIRONMENT=development

# Maximum document size for ingestion (MB)
MAX_DOCUMENT_SIZE_MB=50

# Chunk size for legal text splitting
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# -----------------------------------------------------------------------------
# Backup Configuration
# -----------------------------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
ENABLE_VERIFICATION=true
ENABLE_CITATION_TRACKING=true
ENABLE_USAGE_LOGGING=true
